RULECAM_MODE=replay            # live | record | replay
RULECAM_DATA_DIR=./data
# RULECAM_REPLAY_DIR=          # optional override of the replay cache directory
META_API_KEY=                  # Meta Model API (Spark, Voice Transcribe, Muse Image, SAM 3.1 hosted). Standard tier, never Contributor.
META_API_BASE_URL=             # from dev.meta.ai docs; do not hard-code
BASETEN_API_KEY=               # Muse Spark Open on Baseten
BASETEN_BASE_URL=https://inference.baseten.co/v1   # Baseten OpenAI-compatible Model APIs
BASETEN_SPARK_OPEN_MODEL=meta-models/muse-spark-open-1026   # confirm the exact ID in #credit-requests
GLIMMER_BASE_URL=http://127.0.0.1:8080/v1   # llama-server OpenAI-compatible endpoint
GLIMMER_API_KEY=               # only when llama-server runs remotely with --api-key
HF_TOKEN=                      # gated: Prompt Guard 2, SAM 3.1, SAM Audio
MODAL_TOKEN_ID=
MODAL_TOKEN_SECRET=
SAM_BASE_URL=                  # self-hosted SAM 3.1 on our GPU pod (sam_server), e.g. https://<gpu-pod>-8090.proxy.runpod.net; wins over Modal
SAM_API_KEY=                   # Bearer key of that server; keep it in a 600 file on the API pod, not here
KASA_PLUG_HOST=                # smart plug for the toy-forklift interlock
KASA_LIGHT_HOST=               # stack light / RGB bulb
WHATSAPP_TOKEN=                # should-tier
WHATSAPP_PHONE_NUMBER_ID=
PUBLIC_TUNNEL_URL=             # https tunnel for Pair-a-Phone and webhooks
PUBLIC_UI_URL=                 # public https origin of the web UI (worker page QR on posters)
# Runtime SAM cost control (docs/deploy.md, "Runtime SAM cost")
RULECAM_IDLE_STRIDE_LOW=3      # idle camera (no candidate, nothing relevant in view): segment one chunk in N
RULECAM_IDLE_STRIDE_MEDIUM=3
RULECAM_IDLE_STRIDE_HIGH=2     # at most 2; motion on a camera with a HIGH rule switches to every chunk at once
RULECAM_IDLE_HOLDOFF_S=30      # keep segmenting every chunk this long after a candidate, a relevant object or (HIGH) motion
RULECAM_SAM_BUDGET_FRAMES_PER_MIN=1000   # per camera, billed SAM frames in the last minute; 0 = no budget
RULECAM_SAM_BUDGET_STRIDE=3    # over budget: segment one chunk in N (never while a HIGH rule's camera is active)
RULECAM_RUNTIME_CONCEPT_WORKERS=4        # concepts of one chunk segmented in parallel
PLANNER_SURVEY_WINDOW_S=60     # seconds of recent chunks the planner takes survey/probe frames from (up to 3 per chunk)
